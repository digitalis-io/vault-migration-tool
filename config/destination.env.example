# Destination cluster configuration
# Copy to destination.env and fill in your values:
#   cp destination.env.example destination.env

# ── Required ─────────────────────────────────────────────────────────────────
VAULT_ADDR="https://destination-vault.example.com:8200"
VAULT_TOKEN="hvs.xxxxxxxxxxxxxxxxxxxx"
CLUSTER_NAME="destination-prod"

# ── Optional ─────────────────────────────────────────────────────────────────
# Enterprise namespace (leave empty for OSS / root namespace)
VAULT_NAMESPACE=""

# TLS settings
VAULT_SKIP_VERIFY="false"
VAULT_CACERT=""

# Medusa overrides (defaults to VAULT_ADDR / VAULT_TOKEN)
MEDUSA_ADDR=""
MEDUSA_INSECURE="false"
