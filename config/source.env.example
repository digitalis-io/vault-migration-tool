# Source cluster configuration
# Copy to source.env and fill in your values:
#   cp source.env.example source.env

# ── Required ─────────────────────────────────────────────────────────────────
VAULT_ADDR="https://source-vault.example.com:8200"
VAULT_TOKEN="hvs.xxxxxxxxxxxxxxxxxxxx"
CLUSTER_NAME="source-prod"

# ── Optional ─────────────────────────────────────────────────────────────────
# Enterprise namespace (leave empty for OSS / root namespace)
VAULT_NAMESPACE=""

# TLS settings
VAULT_SKIP_VERIFY="false"
VAULT_CACERT=""

# Medusa overrides (defaults to VAULT_ADDR / VAULT_TOKEN)
MEDUSA_ADDR=""
MEDUSA_INSECURE="false"
